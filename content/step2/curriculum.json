      "outcome": "目的に合う図を選び、寸法を固定して保存し、未見データでも選択理由と非主張事項を説明できる",
      "outcomeDimensions": ["reproducible-execution", "figure-export-contract", "evidence-matched-reporting", "interpretation-limits", "transfer"],
      "concepts": ["ggsave", "figure dimensions", "caption", "transfer", "reporting limits"],
      "directEvidence": [
        {
          "artifact": "再生成可能な2図・3CSV・探索メモ",
          "method": "portfolio",
          "criterion": "空のEnvironmentから全成果物を再生成し、入力・図の選択理由・観察結果・限界を第三者が追跡できる",
          "assessmentIds": ["step2-l20-q4-final-report"]
        },
        {
          "artifact": "未見データの図選択課題",
          "method": "transfer-task",
          "criterion": "列名と文脈を変えたデータで、問いと変数型に基づいて図を選び直す",
          "assessmentIds": ["step2-l20-q5-transfer-sleep"]
        }
      ]

      "output/participant_differences.csv",
      "output/condition_distributions.png",
      "output/participant_differences.png",
      "output/exploratory_note.txt"
    ]
  },
  "lessons": [
    {
      "id": "step2-describe-distributions",
      "displayNumber": 17,
      "title": "分析単位を決めて分布を要約する",
      "prerequisites": ["l16"],
      "outcome": "試行数と参加者数を区別し、参加者×条件の要約から中央値・四分位範囲・個人差を説明できる",
      "outcomeDimensions": ["analysis-unit", "descriptive-summary", "interpretation-limits", "transfer"],
      "concepts": ["analysis unit", "median", "quartile", "IQR", "participant-level summary"],
      "directEvidence": [
        {
          "artifact": "参加者×条件の要約CSVと記述統計CSV",
          "method": "performance-task",
          "criterion": "24名を分析単位として48行を作り、条件別の中央値・Q1・Q3・IQRを再生成する"
        },
        {
          "artifact": "分析単位の説明",
          "method": "constructed-response",
          "criterion": "884正答試行を884人として扱わず、参加者内反復を先に要約する理由を説明する",
          "assessmentIds": ["step2-l17-q4-independence-explanation"]
        },
        {
          "artifact": "未見の反復測定データにおける分析単位の再設計",
          "method": "transfer-task",
          "criterion": "列名と文脈が変わっても、誰のどの条件を1行にするかを説明する",
          "assessmentIds": ["step2-l17-q5-transfer-diary"]
        }
      ]
    },
    {
      "id": "step2-grammar-of-graphics",
      "displayNumber": 18,
      "title": "データ・対応付け・図形を重ねる",
      "prerequisites": ["step2-describe-distributions"],
      "outcome": "変数型と問いからaesとgeomを選び、分布を隠さない図を作成できる",
      "outcomeDimensions": ["aesthetic-mapping", "layer-composition", "distribution-visibility", "reporting-context", "transfer"],
      "concepts": ["ggplot", "aes", "geom", "layer", "distribution"],
      "directEvidence": [
        {
          "artifact": "条件別分布図",
          "method": "code-construction",
          "criterion": "参加者平均の全点と分布要約を同時に示し、軸・単位・合成データ表記を付ける"
        },
        {
          "artifact": "全点を残す作図理由と非主張事項の説明",
          "method": "constructed-response",
          "criterion": "箱ひげと参加者点の役割を分け、図だけでは有意差・母集団差・因果効果を結論しない",
          "assessmentIds": ["step2-l18-q4-why-points"]
        },
        {
          "artifact": "未見のカテゴリ×連続量データに対する作図設計",
          "method": "transfer-task",
          "criterion": "変数型からaesとgeomを選び、全観測・単位・データ由来を残す",
          "assessmentIds": ["step2-l18-q5-transfer-yield"]
        }
      ]
    },
    {
      "id": "step2-show-individuals",
      "displayNumber": 19,
      "title": "平均の背後にある個人差を示す",
      "prerequisites": ["step2-grammar-of-graphics"],
      "outcome": "対応のあるデータを参加者内で結び、平均値だけでは失われる方向とばらつきを説明できる",
      "outcomeDimensions": ["pairing-key", "within-participant-change", "individual-heterogeneity", "interpretation-limits", "transfer"],
      "concepts": ["paired data", "individual differences", "overplotting", "faceting"],
      "directEvidence": [
        {
          "artifact": "参加者内条件差の図と解釈",
          "method": "performance-task",
          "criterion": "同一参加者を対応付け、24名の方向と差の範囲を図と文章で一致させる"
        },
        {
          "artifact": "分布図と対応図の役割・限界の説明",
          "method": "constructed-response",
          "criterion": "条件内分布と参加者内変化を区別し、どちらも母集団差や因果効果を証明しないと説明する",
          "assessmentIds": ["step2-l19-q4-compare-plots"]
        },
        {
          "artifact": "未見の前後測定データに対する対応図設計",
          "method": "transfer-task",
          "criterion": "個体IDを対応キーとして、前後の点と線、単位、非主張事項を設計する",
          "assessmentIds": ["step2-l19-q5-transfer-blood-pressure"]
        }
      ]
    },
    {
      "id": "step2-report-and-transfer",
      "displayNumber": 20,
      "title": "図を保存し、選択理由と限界を報告する",
